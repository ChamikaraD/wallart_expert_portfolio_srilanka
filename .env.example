# Copy this file to .env.local (never commit .env.local) and fill in the values.
# On Vercel/your host, add the same variables in the project's Environment Variables settings.

# Production URL used for canonical links, Open Graph and the sitemap
NEXT_PUBLIC_SITE_URL=https://your-domain.lk

# --- Contact form: email notification (Gmail) -------------------------------
# The Gmail account that sends the notification, and a 16-character App Password
# (Google Account → Security → 2-Step Verification → App passwords). Not the normal password.
GMAIL_USER=wallartexpertpvt@gmail.com
GMAIL_APP_PASSWORD=
# Optional: where inquiries are delivered (defaults to the email in src/config/site.ts)
INQUIRY_TO_EMAIL=

# --- Contact form: WhatsApp notification ------------------------------------
# Option A (recommended): WhatsApp Business Cloud API by Meta. See README → "Contact form notifications".
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Number that receives inquiry alerts, international format without "+"
WHATSAPP_TO=94702341274
# Name of your approved message template (leave empty to send plain text — only delivered
# within 24h of the owner messaging the business number)
WHATSAPP_TEMPLATE=new_website_inquiry
WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_GRAPH_VERSION=v23.0

# Option B (fallback): CallMeBot free personal alerts — used only if Option A is not set.
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
